# Normalize line endings on checkin so Windows and POSIX contributors produce
# identical diffs. Files are stored with LF in the object database.
* text=auto eol=lf

# Windows-native scripts must keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets are never line-ending converted.
*.joblib binary
*.pkl    binary
*.png    binary
*.jpg    binary
*.ico    binary
*.woff   binary
*.woff2  binary