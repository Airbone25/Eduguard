      "html": "<label class=\"ds-label\" for=\"ds-school\">School</label><input class=\"ds-input\" id=\"ds-school\" placeholder=\"School slug\" />",
      "css": ".ds-label{font-family:var(--font-sans,\"Segoe UI\",Arial,sans-serif);display:block;font-size:13px;font-weight:600;margin-bottom:8px;color:var(--ink,#342737)}.ds-input{font-family:var(--font-sans,\"Segoe UI\",Arial,sans-serif);display:block;width:calc(100% - 28px);height:24px;padding:10px 13px;border:1px solid #cfc5ce;border-radius:6px;font-size:14px;background:var(--surface,#fff);color:var(--ink,#342737);transition:background-color 160ms,color 160ms,border-color 160ms;}.ds-input::placeholder{color:var(--muted,#716966)}.ds-input:focus-visible{outline:3px solid #8c6293;outline-offset:3px;}.ds-input:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-input{transition-duration:.01ms}}"
