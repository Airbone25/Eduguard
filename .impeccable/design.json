    {
      "name": "Signal panel",
      "kind": "card",
      "refersTo": "signal-panel",
      "description": "White, ruled working container with softly rounded outer corners.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-heading\"><h2>Students to check in with</h2><p>Across your classes</p></div><p class=\"ds-panel-row\">New signals appear after weekly observations are assessed.</p></section>",
      "css": ".ds-panel{font-family:var(--font-sans,\"Segoe UI\",Arial,sans-serif);background:var(--surface,#fff);border:1px solid var(--rule,#e3dfda);border-radius:var(--radius,12px);overflow:hidden;color:var(--ink,#342737)}.ds-panel-heading{padding:24px 24px 18px}.ds-panel-heading h2{margin:0;font-size:17px;font-weight:600;letter-spacing:-.3px}.ds-panel-heading p{margin:5px 0 0;font-size:12px;color:var(--muted,#716966)}.ds-panel-row{margin:0;padding:23px 24px 18px;border-top:1px solid var(--rule,#e3dfda);font-size:13px}"
    },
    {
      "name": "Evidence disclosure",
      "kind": "custom",
      "refersTo": "evidence-content",
      "description": "Native in-place disclosure; this preview uses the implemented missing-evidence state.",
      "html": "<details class=\"ds-evidence\"><summary>View evidence <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></summary><div class=\"ds-evidence-content\"><strong>What informed this signal</strong><p>No contributing factors are available for this observation.</p><small>Advisory only. Review the context before taking action.</small></div></details>",
      "css": ".ds-evidence{font-family:var(--font-sans,\"Segoe UI\",Arial,sans-serif);color:var(--ink,#342737)}.ds-evidence summary{display:flex;align-items:center;gap:8px;width:fit-content;font-size:12px;color:var(--muted,#716966);list-style:none;cursor:pointer;transition:background-color 160ms,color 160ms,border-color 160ms;}.ds-evidence summary::-webkit-details-marker{display:none}.ds-evidence summary:focus-visible{outline:3px solid #8c6293;outline-offset:3px;}.ds-evidence[open] summary{color:var(--plum,#49344c)}.ds-evidence[open] summary svg{transform:rotate(180deg)}.ds-evidence-content{background:#f6f2f7;padding:18px;margin-top:13px;border-radius:6px;font-size:13px;line-height:1.7;animation:ds-unfold 220ms var(--ease-out,cubic-bezier(.16,1,.3,1))}.ds-evidence-content small{display:block;color:var(--muted,#716966);margin-top:10px}@keyframes ds-unfold{from{opacity:.5;transform:translateY(-3px)}to{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){.ds-evidence-content{animation-duration:.01ms}.ds-evidence summary{transition-duration:.01ms}}"
    },
    {
      "name": "Metric reading",
      "kind": "custom",
      "refersTo": "metric",
      "description": "A quiet labelled reading with supporting context.",
      "html": "<div class=\"ds-metric\"><div class=\"ds-metric-label\">Students</div><div class=\"ds-metric-value\">—</div><p class=\"ds-metric-detail\">Enrolled in this class</p></div>",
      "css": ".ds-metric{font-family:var(--font-sans,\"Segoe UI\",Arial,sans-serif);padding:18px 20px;border-bottom:1px solid var(--rule,#e3dfda);color:var(--ink,#342737)}.ds-metric-label{font-size:12px;color:var(--muted,#716966)}.ds-metric-value{font-size:31px;line-height:1.3;font-weight:550;font-variant-numeric:tabular-nums;margin-top:6px;letter-spacing:-.8px}.ds-metric-detail{font-size:11px;color:var(--muted,#716966);margin:6px 0 0}"
    }
  ],
  "narrative": {
    "northStar": "The learning journal",
    "overview": "EduGuard uses the quiet clarity of academic editorial design: warm paper, deep plum, generous Georgia headings, and precise sans-serif controls. The interface gives people and their observations room to be read while keeping records, evidence, and actions close together.\n\nThe system is calm and practical. Fine rules and pale washes organize information; conventional navigation, tables, forms, and native disclosures carry the work. The journal is expressed through typography and spacing, without inventing unfamiliar controls or decorative imagery.",
    "keyCharacteristics": [
      "Warm paper and white surfaces with a deep plum navigation rail.",
      "Georgia headings paired with Segoe UI controls and tabular working numbers.",
      "Ruled records, softly rounded panels, and restrained lilac emphasis.",
      "Text-labelled rust, ochre, and sage states.",
      "Evidence revealed in place with native disclosures.",
      "Plain language that preserves human judgment and student privacy."
    ],
    "rules": [
      {
        "name": "The Named State Rule",
        "body": "Every support state is named in text; color and icons supplement that name.",
        "section": "colors"
      },
      {
        "name": "The Reading Order Rule",
        "body": "Use heading size and space to establish hierarchy; keep operational labels quiet and readable.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Establish ordinary hierarchy with spacing, rules, and tone; reserve pronounced elevation for content floating above the page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared tokens, page headers, controls, and state components across roles.",
      "Do keep support states text-labelled and keyboard focus visible.",
      "Do keep evidence beside the teacher's review action and identify model output as advisory.",
      "Do preserve reduced-motion behavior and contain wide records within table scroll regions.",
      "Do label synthetic, read-only demo data clearly and keep validity limits honest."
    ],
    "donts": [
      "Don't expose risk probabilities, risk levels, internal severity, or teacher-only AI outputs in student views.",
      "Don't present a signal as a diagnosis, verdict, or demonstrated real-school performance.",
      "Don't replace raw weekly observation fields with derived model features.",
      "Don't invent observations, evidence, customers, testimonials, deployment claims, or unimplemented product capabilities.",
      "Don't reintroduce the retired catalogue tabs, vermilion action palette, or stamped micro-label system."
    ]
  }
}
