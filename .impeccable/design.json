    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Plum action with the shared control geometry.",
      "html": "<button class=\"ds-primary\">Record this week</button>",
      "css": ".ds-primary{font-family:var(--font-sans,\"Segoe UI\",Arial,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:10px 15px;border:1px solid transparent;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;transition:background-color 160ms,color 160ms,border-color 160ms;background:var(--plum,#49344c);color:white}.ds-primary:hover{background:#624969}.ds-primary:focus-visible{outline:3px solid #8c6293;outline-offset:3px;}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition-duration:.01ms}}"
    },
