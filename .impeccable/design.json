      "css": ".ds-nav{background:var(--plum-deep,#352638);padding:20px;max-width:232px}.ds-nav-link{font-family:var(--font-sans,\"Segoe UI\",Arial,sans-serif);display:flex;align-items:center;min-height:24px;padding:11px 14px;color:#ddcfdf;border-radius:7px;margin-bottom:5px;font-size:14px;text-decoration:none;transition:background-color 160ms,color 160ms,border-color 160ms;}.ds-nav-link:hover{background:#4c3a50;color:white}.ds-nav-link.ds-selected{background:#efe7f1;color:var(--plum,#49344c);font-weight:600}.ds-nav-link:focus-visible{outline:3px solid #8c6293;outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition-duration:.01ms}}"
