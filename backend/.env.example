APP_NAME=EduGuard API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://eduguard:eduguard@localhost:5432/eduguard
# Development only. Generate a random secret before deployment.
JWT_SECRET=development-only-change-this-secret-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
MODEL_BUNDLE_PATH=artifacts/eduguard_risk_model.joblib
MODEL_METADATA_PATH=artifacts/model_metadata.json
POSTGRES_USER=eduguard
POSTGRES_PASSWORD=eduguard
POSTGRES_DB=eduguard
